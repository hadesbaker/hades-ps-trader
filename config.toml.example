# Wallet Configuration
wallet_path = "wallet.json"
# Generate a new wallet with: solana-keygen new --outfile wallet.json

# Trading Configuration
[trading]
# Slippage tolerance (percentage) — starting value. Sells escalate from here
# up to +95% in 5% steps to avoid bag-holding.
slippage = 10.0
# Lamports per buy. Each MACD bullish crossover spends this much.
trade_amount = 250_000_000  # 0.25 SOL
# Priority fee per tx (in SOL). Required by PumpPortal /api/trade-local.
priority_fee_sol = 0.0005
# --- Position exit (PnL-driven) ---
# Entries are MACD bullish crossovers; exits are decided by the four rules
# below, evaluated on every price tick while a position is open. The first
# rule that trips wins. Priority: max_hold_time > stop_loss > profit_target >
# trailing stop.
# Take-profit: exit once PnL reaches this percent gain. 0 disables it.
profit_target_percent = 0
# Hard stop-loss: exit once PnL falls to this percent loss. 0 disables it.
stop_loss_percent = 30.0
# Maximum number of concurrent OPEN positions across ALL monitored tokens.
# A token in its monitoring window without an open trade does NOT consume a
# slot — so the bot can monitor many tokens at once while only ever holding
# this many at any moment.
max_positions = 3
# RPC-side rebroadcast retries for buy / sell tx
buy_tx_retries = 5
sell_tx_retries = 5
# How often (ms) the price feed reads the PumpSwap pool's vaults via a single
# getMultipleAccounts call. Each read feeds the candle aggregator.
price_poll_interval_ms = 500
# Emit a `PNL MONITOR` info line every N successful price ticks while a
# position is open. 0 disables it (per-tick debug log is unaffected).
pnl_log_every_n_ticks = 5
# Total seconds to monitor a single token after graduation. Within this window
# the bot may buy and sell that token any number of times based on MACD
# signals. When the window expires, no new buys; any open position is
# force-sold using the standard sell flow before the session ends.
# 0 = monitor indefinitely (until the process exits).
max_monitor_time = 3600  # 1 hour
# Maximum seconds to hold a SINGLE open position before exiting it via the
# standard sell flow. The timer starts when the buy tx confirms. This is a
# per-position cap, distinct from max_monitor_time (the per-token session
# window). Set 0 to disable.
max_hold_time = 900  # 15 minutes
# Dynamic trailing stop: comma-separated "gain%:trail%" tiers. Once peak PnL
# crosses a tier's gain%, the position exits if PnL drops trail% back from its
# peak. Higher tiers widen the trail so a strong runner isn't cut early.
# Example: at "20:8", once peak PnL hits +20%, exit on an 8-point pullback.
dynamic_trailing_stop_thresholds = "20:8,30:10,40:13,55:16,75:20,100:22,130:25"

# MACD Configuration
[macd]
# Candle (bar) timeframe in seconds. MACD runs on candle closes.
# Smaller = more signals + more noise. Larger = fewer, cleaner signals + longer
# warmup. Note: warmup needs (slow + signal) candles before any signals fire.
candle_interval_secs = 60  # 1m candles
# Classic MACD periods (12 / 26 / 9). EMAs are seeded with an SMA of the first
# `period` values, then updated with the standard k = 2/(period+1) formula.
fast = 12
slow = 26
signal = 9
# Minimum seconds between a sell and the next buy on the same token. Filters
# out whipsaw re-entries on noisy crossovers. Set 0 to disable.
cooldown_secs = 30

# Trading Filters
# Run ONCE at graduation, before monitoring starts. If a filter fails, the
# token is not monitored at all.
# Set enabled = false to skip every check. Set any individual value to 0 to
# disable just that check.
[tradingfilters]
enabled = false
min_holders = 100
min_txs = 250
# Reject if the combined balance of the top 10 holders (excluding the PumpSwap
# pool's base vault and the pump.fun bonding-curve PDA) exceeds this fraction
# of total supply. Units are FRACTION, not percent: 0.05 = 5%, 0.30 = 30%.
# Set 0 to disable.
top_ten_holder_percentage = 0.30

# Pre-Buy Rug Detection
# Evaluated on every bullish crossover, right before a buy would fire, using
# the price + pool-liquidity history gathered since the session started. A
# failing check skips just that buy; the session keeps monitoring, so a later
# signal can still buy if the token recovers. Independent of [tradingfilters]
# (which run once at graduation) — this runs continuously, per candidate buy.
# If this whole section is omitted, the defaults below apply (guard enabled).
[rug]
# Master switch. false = never block a buy.
enabled = true
# Minimum WSOL liquidity (in SOL) the PumpSwap pool must hold to allow a buy.
# A pulled-liquidity rug drains this toward zero. TUNE THIS to the typical
# healthy pool size of freshly graduated tokens. Set 0 to disable this check.
min_pool_sol = 5.0
# Skip the buy if pool liquidity is down more than this % from its session
# peak (liquidity actively being removed). Set 0 to disable.
max_liquidity_drop_pct = 50.0
# Skip the buy if price is down more than this % from the session high — the
# token already pumped and dumped ("the price just sits there"). Set 0 to
# disable.
max_drawdown_pct = 70.0
# Minimum price samples gathered before the guard will clear any buy. At
# price_poll_interval_ms=500 a sample is ~0.5s, so 20 ≈ 10s of history.
min_samples = 20
