# Wallet Configuration
wallet_path = "wallet.json"
# Generate a new wallet with: solana-keygen new --outfile wallet.json

# Trading Configuration
[trading]
# Slippage tolerance (percentage) — starting value. Sells escalate from here
# up to +95% in 5% steps to avoid bag-holding.
slippage = 10.0
# Lamports per buy. Each MACD bullish crossover spends this much.
trade_amount = 250_000_000  # 0.25 SOL
# Priority fee per tx (in SOL). Required by PumpPortal /api/trade-local.
priority_fee_sol = 0.0005
# --- Position exit (PnL-driven) ---
# Entries are MACD bullish crossovers; exits are decided by the four rules
# below, evaluated on every price tick while a position is open. The first
# rule that trips wins. Priority: max_hold_time > stop_loss > profit_target >
# trailing stop.
# Take-profit: exit once PnL reaches this percent gain. 0 disables it.
profit_target_percent = 0
# Hard stop-loss: exit once PnL falls to this percent loss. 0 disables it.
stop_loss_percent = 30.0
# Maximum number of concurrent OPEN positions across ALL monitored tokens.
# A token in its monitoring window without an open trade does NOT consume a
# slot — so the bot can monitor many tokens at once while only ever holding
# this many at any moment.
max_positions = 3
# RPC-side rebroadcast retries for buy / sell tx
buy_tx_retries = 5
sell_tx_retries = 5
# How often (ms) the price feed reads the PumpSwap pool's vaults via a single
# getMultipleAccounts call. Each read feeds the candle aggregator.
price_poll_interval_ms = 500
# Emit a `PNL MONITOR` info line every N successful price ticks while a
# position is open. 0 disables it (per-tick debug log is unaffected).
pnl_log_every_n_ticks = 5
# Total seconds to monitor a single token after graduation. Within this window
# the bot may buy and sell that token any number of times based on MACD
# signals. When the window expires, no new buys; any open position is
# force-sold using the standard sell flow before the session ends.
# 0 = monitor indefinitely (until the process exits).
max_monitor_time = 3600  # 1 hour
# Maximum seconds to hold a SINGLE open position before exiting it via the
# standard sell flow. The timer starts when the buy tx confirms. This is a
# per-position cap, distinct from max_monitor_time (the per-token session
# window). Set 0 to disable.
max_hold_time = 900  # 15 minutes
# Dynamic trailing stop: comma-separated "gain%:trail%" tiers. Once peak PnL
# crosses a tier's gain%, the position exits if PnL drops trail% back from its
# peak. Higher tiers widen the trail so a strong runner isn't cut early.
# Example: at "20:8", once peak PnL hits +20%, exit on an 8-point pullback.
dynamic_trailing_stop_thresholds = "20:8,30:10,40:13,55:16,75:20,100:22,130:25"

# MACD Configuration
[macd]
# Candle (bar) timeframe in seconds. MACD runs on candle closes.
# Smaller = more signals + more noise. Larger = fewer, cleaner signals + longer
# warmup. Note: warmup needs (slow + signal) candles before any signals fire.
candle_interval_secs = 60  # 1m candles
# Classic MACD periods (12 / 26 / 9). EMAs are seeded with an SMA of the first
# `period` values, then updated with the standard k = 2/(period+1) formula.
fast = 12
slow = 26
signal = 9
# Minimum seconds between a sell and the next buy on the same token. Filters
# out whipsaw re-entries on noisy crossovers. Set 0 to disable.
cooldown_secs = 30

# Trading Filters
# Run ONCE at graduation, before monitoring starts. If a filter fails, the
# token is not monitored at all.
# Set enabled = false to skip every check. Set any individual value to 0 to
# disable just that check.
[tradingfilters]
enabled = false
min_holders = 100
min_txs = 250
# Reject if the combined balance of the top 10 holders (excluding the PumpSwap
# pool's base vault and the pump.fun bonding-curve PDA) exceeds this fraction
# of total supply. Units are FRACTION, not percent: 0.05 = 5%, 0.30 = 30%.
# Set 0 to disable.
top_ten_holder_percentage = 0.30

# Continuous Rug Detection
# Evaluated on EVERY price tick against the price + pool-liquidity history
# gathered since the session started. When any threshold trips, the session
# force-sells any open position (reason "Rug detected") and abandons the token
# entirely — no more RPC polls for it. Independent of [tradingfilters] (which
# run once at graduation) — this runs throughout the session, per tick.
# If this whole section is omitted, the defaults below apply (guard enabled).
[rug]
# Master switch. false = never abandon a token.
enabled = true
# Minimum WSOL liquidity (in SOL) the PumpSwap pool must hold. A pulled-
# liquidity rug drains this toward zero. TUNE THIS to the typical healthy pool
# size of freshly graduated tokens. Set 0 to disable this check.
min_pool_sol = 5.0
# Abandon the token if pool liquidity is down more than this % from its session
# peak (liquidity actively being removed). NOTE: under per-tick abandon, this
# threshold matters more than it did under the old per-crossover skip — too
# tight = false-positive abandons on temporary liquidity dips. Set 0 to disable.
max_liquidity_drop_pct = 50.0
# Abandon the token if price is down more than this % from the session high —
# the token already pumped and dumped ("the price just sits there"). Set 0 to
# disable.
max_drawdown_pct = 70.0
# Minimum price samples gathered before the guard will judge a token. Below
# this, is_rugged() returns None regardless of conditions. At
# price_poll_interval_ms=500 a sample is ~0.5s, so 20 ≈ 10s of history.
min_samples = 20

# Capitulation Dip-and-Reclaim Entry (alternative to MACD)
# Two-stage entry trigger. When enabled=true, MACD bullish crossovers no
# longer trigger buys (MACD candle aggregation and logging continue, but
# only for analysis). Capitulation REPLACES MACD as the entry trigger.
#
#   STAGE 1: detect dump — price down dip_pct over window_secs → record the
#            local low, do NOT buy yet. Continue tracking the lowest price
#            during the dump.
#   STAGE 2: wait for bounce — price reclaims reclaim_pct above the local
#            low AND sustains it for reclaim_confirm_secs seconds → fire a
#            buy.
# If no confirmed reclaim within pending_expire_secs of the dump → abandon
# the pending state and reset. After firing, debounced for debounce_secs.
# Post-sell cooldown_secs from [macd] still applies after an exit.
#
# Why bounce-buy (vs the earlier dip-only variant): test9 measured ~9pp of
# signal-tick edge lost to execution because dip-only buys land mid-dump
# while liquidity is fleeing. Buying the reclaim targets the moment
# liquidity returns. Defaults below are placeholders; reclaim_pct and the
# stage-2 timing knobs need a sweep against live data.
[capitulation]
# Master switch. false = MACD remains the entry trigger; this detector never
# runs.
enabled = false
# STAGE 1 — Required dip size in percent. Sets the bar for what counts as a
# capitulation event. Defaults from analysis/capitulation.py sweep.
dip_pct = 50.0
# STAGE 1 — Rolling-window length in seconds for the dump detection. The
# detector compares current price to the OLDEST tick still inside this window.
window_secs = 60
# STAGE 2 — Required reclaim off the local low, in percent. Larger waits for
# stronger bounces but misses fast V-recoveries; smaller catches weaker
# bounces but more false starts.
reclaim_pct = 10.0
# STAGE 2 — How long (seconds) the reclaim threshold must be continuously
# sustained before firing. Falling back below the threshold resets the
# confirmation timer. Filters spike-and-fade fake bounces. 0 = fire on first
# reclaim tick.
reclaim_confirm_secs = 10
# How long (seconds) to keep watching for a reclaim after STAGE 1 trips. If
# no confirmed reclaim within this window, the pending dump is abandoned and
# the detector resets — useful so we don't keep watching dead tokens.
pending_expire_secs = 30
# Post-fire debounce in seconds — suppresses re-firing on the same session.
# Independent of the post-sell cooldown_secs from [macd], which still applies
# after an exit.
debounce_secs = 60
