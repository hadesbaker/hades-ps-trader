# Log level. Optional, defaults to "info". Set "debug" to see per-tick price
# polls and MACD bar updates; set "hades_ps_trader=debug" to keep solana-client
# / reqwest quiet.
RUST_LOG=info

# Solana RPC URL — used for all on-chain reads, transaction submission, and
# WebSocket subscriptions (the bot derives wss:// from this URL).
# Free public endpoint shown; replace with a paid provider (QuikNode, Helius, etc.)
# for production use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PumpPortal API key. Optional. Appended as a query string on the WS URL.
PUMPPORTAL_API_KEY=

# Discord webhook URL. Optional. If set, the bot posts an embed on every
# confirmed buy and every sell submission. Leave blank to disable.
DISCORD_WEBHOOK_URL=
